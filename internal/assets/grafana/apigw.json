{
  "annotations": {"list": []},
  "description": "apigw default dashboard. Import into Grafana and point at the Prometheus datasource scraping the apigw /metrics endpoint.",
  "editable": true,
  "graphTooltip": 0,
  "title": "apigw",
  "uid": "apigw-default",
  "version": 1,
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"}
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Webhooks accepted (rate)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "rate(apigw_webhooks_accepted_total[1m])", "legendFormat": "{{instance}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Webhook HMAC failures (rate)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "rate(apigw_webhook_hmac_fails_total[1m])", "legendFormat": "{{instance}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Deploys (rate by status)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum by (status) (rate(apigw_deploy_apply_total[5m]))", "legendFormat": "{{status}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Deploy duration (p95)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(apigw_deploy_apply_duration_seconds_bucket[10m])))", "legendFormat": "p95"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SSE clients connected",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "apigw_sse_clients"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Events published (rate)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "rate(apigw_events_published_total[1m])", "legendFormat": "{{topic}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 16}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Nginx reloads (cumulative)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "apigw_nginx_reload_total", "legendFormat": "{{result}}"}
      ],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16}
    }
  ]
}
