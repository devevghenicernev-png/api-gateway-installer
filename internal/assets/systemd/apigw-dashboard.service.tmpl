[Unit]
Description=apigw live dashboard + webhook receiver + deploy worker
Documentation=https://apigw.dev/dashboard
After=network-online.target nginx.service
Wants=network-online.target
PartOf=apigw.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
ExecStart={{ .BinPath }} dashboard serve --addr {{ .Addr }} --webhook-addr {{ .WebhookAddr }}
Restart=on-failure
RestartSec=2s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apigw-dashboard

# --- identity ---
# Root for now — Phase 7 will introduce a dedicated `apigw` user with
# CAP_NET_BIND_SERVICE so the dashboard binds 443 without privileges. Until
# the worker stops needing systemctl write access, we stay root.
User=root
Group=root

# --- hardening — single Go binary, no JIT → MDWX is safe ---
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute is safe here: Go has no JIT (don't put a comment on
# the same line — systemd parses the value as `true        # safe...` and
# silently ignores the directive, leaving MDWX OFF).
MemoryDenyWriteExecute=true
RestrictRealtime=true
NoNewPrivileges=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @reboot @raw-io
# @privileged subtraction above also removes the chown family
# (chown/fchown/fchownat/lchown), which the deploy worker needs to hand
# ownership of release trees between apigw-build (build phase) and
# apigw-run (runtime), plus to chown the persistent shared/ dirs. The
# webhook-triggered deploy path lives inside this service, so without
# the re-add the process gets SIGSYS'd on every deploy. We're already
# running as root; allowing chown grants nothing root doesn't have.
SystemCallFilter=@chown

# systemd creates and owns the state + log dirs BEFORE the namespace is
# built, so we don't need to also list them in ReadWritePaths= (listing a
# nonexistent dir there triggers status=226/NAMESPACE on a fresh box).
StateDirectory=apigw
LogsDirectory=apigw

# Worker writes deploy state + units; dashboard reads /etc/apigw config; both
# touch the bbolt queue at /var/lib/apigw/jobs.db.
ReadWritePaths=/etc/apigw /etc/nginx /etc/systemd/system /run

# --- resource limits ---
TasksMax=512
LimitNOFILE=4096
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
