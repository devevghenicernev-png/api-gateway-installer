# {{ .Banner }}

# TLS-enabled nginx config managed by apigw.
# Strategy: {{ .TLSStrategy }}. Domains: {{ range .TLSDomains }}{{ . }} {{ end }}
# To change: `apigw tls enable` / `apigw tls disable`.

# Plain-HTTP server: serves ACME challenges and redirects everything else to HTTPS.
server {
    listen      {{ .HTTPPort }};
    listen      [::]:{{ .HTTPPort }};
    server_name {{ range .TLSDomains }}{{ . }} {{ end }};

    location /.well-known/acme-challenge/ {
        root {{ .AcmeWebroot }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main HTTPS server.
server {
    # http2 as a `listen` parameter works on every nginx since 1.9.5 (all
    # current LTS distros). The standalone `http2 on;` directive was added
    # in 1.25.1 — Debian 12 (1.22), Ubuntu 22.04 (1.18), Ubuntu 24.04 (1.24)
    # all reject it. Sticking with the listen-param form means TLS works
    # out of the box on every supported host.
    listen      {{ .HTTPSPort }} ssl http2;
    listen      [::]:{{ .HTTPSPort }} ssl http2;
    server_name {{ range .TLSDomains }}{{ . }} {{ end }};

    ssl_certificate     {{ .CertFile }};
    ssl_certificate_key {{ .KeyFile }};

    {{ if .MTLSAnyEnabled -}}
    # mTLS — at least one API requires client cert auth. We set this at
    # server scope (nginx limit: one ssl_client_certificate per server),
    # with verify=optional so non-mTLS APIs still work. Per-API allow-list
    # enforcement happens via auth_request to the dashboard.
    ssl_client_certificate {{ .MTLSCAFile }};
    ssl_verify_client      optional;
    ssl_verify_depth       4;
    {{ end -}}

    # Mozilla Intermediate. TLS 1.2 + 1.3 only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;     # TLS 1.3 picks; let client choose for 1.2

    ssl_session_timeout  1d;
    ssl_session_cache    shared:SSL:50m;
    ssl_session_tickets  off;          # forward secrecy

    # OCSP stapling — opt-in via `apigw tls ocsp enable` (TLS.OCSPStapling).
    # OFF for LE certs (Let's Encrypt killed responders on 2025-08-06).
    # ON for DigiCert / Sectigo / internal CAs whose responders are alive.
    {{ if .OCSPStapling -}}
    ssl_stapling        on;
    ssl_stapling_verify on;
    resolver            1.1.1.1 8.8.8.8 valid=300s ipv6=off;
    resolver_timeout    5s;
    {{ end -}}

    # HSTS — 2 years. includeSubDomains only when we control siblings on the apex.
    {{ if .HSTSIncludeSubDomains -}}
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    {{- else -}}
    add_header Strict-Transport-Security "max-age=63072000" always;
    {{- end }}
    add_header X-Content-Type-Options "nosniff" always;

    {{ if .Gzip.Enabled -}}
    # Compression (gzip) — server-scope so we don't double-up with the
    # `gzip on;` the stock nginx.conf declares at http-scope.
    gzip                on;
    gzip_vary           on;
    gzip_proxied        any;
    gzip_comp_level     {{ .Gzip.Level }};
    gzip_min_length     {{ .Gzip.MinLength }};
    gzip_types          {{ range $i, $t := .Gzip.Types }}{{ if $i }} {{ end }}{{ $t }}{{ end }};
    {{ end -}}
    {{ if .Brotli.Enabled -}}
    # Compression (brotli) — REQUIRES ngx_brotli module loaded in main
    # nginx.conf (apt install nginx-module-brotli; load_module …).
    brotli              on;
    brotli_comp_level   {{ .Brotli.Level }};
    brotli_min_length   {{ .Brotli.MinLength }};
    brotli_types        {{ range $i, $t := .Brotli.Types }}{{ if $i }} {{ end }}{{ $t }}{{ end }};
    {{ end }}

    # ACME webroot — kept on the HTTPS server too so renewals work either way.
    location /.well-known/acme-challenge/ {
        root {{ .AcmeWebroot }};
    }

    {{ template "_locations" . }}
}
