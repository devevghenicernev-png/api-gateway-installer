# {{ .Banner }}

# Top-level nginx server block managed by apigw (HTTP-only).
# To add or remove APIs: `apigw api add` / `apigw api remove`.
# To enable HTTPS:       `apigw tls enable …`.

server {
    listen      {{ .HTTPPort }};
    listen      [::]:{{ .HTTPPort }};
    server_name {{ .ServerName }};

    # ACME HTTP-01 webroot. Kept here so `apigw tls enable letsencrypt`
    # works without taking nginx down — apigw drops the token file at
    # {{ .AcmeWebroot }}/.well-known/acme-challenge/<token>.
    location /.well-known/acme-challenge/ {
        root {{ .AcmeWebroot }};
    }

    {{ template "_locations" . }}
}
