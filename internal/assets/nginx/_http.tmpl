# {{ .Banner }}
#
# MANAGED BY apigw — installed into /etc/nginx/conf.d/ so nginx auto-loads it
# at http{} scope. Holds named upstreams, rate-limit zones, gzip settings,
# and the CORS origin map — anything that can't live inside a server block.

{{ if .Gzip.Enabled -}}
# --- Compression ---
gzip                on;
gzip_vary           on;
gzip_proxied        any;
gzip_comp_level     {{ .Gzip.Level }};
gzip_min_length     {{ .Gzip.MinLength }};
gzip_types          {{ range $i, $t := .Gzip.Types }}{{ if $i }} {{ end }}{{ $t }}{{ end }};
{{ end }}

{{ range .Upstreams -}}
# --- Upstream: {{ .Name }} ({{ len .Servers }} server{{ if ne (len .Servers) 1 }}s{{ end }}) ---
upstream apigw_{{ .Name }} {
    {{ if .LoadBalance }}{{ .LoadBalance }};
    {{ end -}}
    {{ range .Servers -}}
    server {{ .Address }}{{ if gt .Weight 0 }} weight={{ .Weight }}{{ end }}{{ if gt .MaxFails 0 }} max_fails={{ .MaxFails }}{{ end }}{{ if .FailTimeout }} fail_timeout={{ .FailTimeout }}{{ end }}{{ if .Backup }} backup{{ end }}{{ if .Down }} down{{ end }};
    {{ end -}}
    keepalive {{ .Keepalive }};
}
{{ end }}

{{ range .RateLimitZones -}}
# --- Rate limit zone: {{ .Name }} ---
limit_req_zone {{ .Key }} zone=apigw_{{ .Name }}:10m rate={{ .RPS }}r/s;
{{ end }}

{{ if .CORSOriginMap -}}
# --- CORS origin allow-list (echo back if exact match, "" otherwise) ---
map $http_origin $apigw_cors_origin {
    default                       "";
    {{ range .CORSOriginMap -}}
    "~^{{ . }}$" $http_origin;
    {{ end -}}
}
{{ end }}

{{ range .SplitClients -}}
# --- Canary split for {{ .Name }} ({{ .CanaryPct }}% to canary) ---
split_clients "{{ .HashSource }}" ${{ .Name }} {
    {{ .CanaryPct }}% {{ .CanaryName }};
    *                {{ .PrimaryName }};
}
{{ end }}

{{ range .CacheZones -}}
# --- Response cache zone: {{ .Name }} ---
proxy_cache_path {{ .Path }} levels=1:2 keys_zone={{ .Name }}:10m max_size={{ .MaxSize }} inactive=60m use_temp_path=off;
{{ end }}

{{ if .JSONLogFormat -}}
# --- Structured JSON access log (SIEM-friendly) ---
log_format apigw_json escape=json '{'
    '"ts":"$time_iso8601",'
    '"remote":"$remote_addr",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"referer":"$http_referer",'
    '"ua":"$http_user_agent",'
    '"forwarded":"$http_x_forwarded_for",'
    '"rtime":$request_time,'
    '"upstream":"$upstream_addr",'
    '"upstream_status":"$upstream_status",'
    '"upstream_rtime":"$upstream_response_time",'
    '"cache":"$upstream_cache_status",'
    '"apigw_subject":"$sent_http_x_apigw_subject"'
'}';
{{ end }}

{{ if and (ne .LogSampleRate 100) (gt .LogSampleRate 0) -}}
# --- Log sampling: only log {{ .LogSampleRate }}% of requests ---
split_clients "$request_id" $apigw_log_sample {
    {{ .LogSampleRate }}% 1;
    *                     0;
}
map $apigw_log_sample $apigw_log_skip {
    1 0;
    default 1;
}
{{ end }}
