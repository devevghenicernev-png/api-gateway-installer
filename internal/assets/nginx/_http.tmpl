# {{ .Banner }}
#
# MANAGED BY apigw — installed into /etc/nginx/conf.d/ so nginx auto-loads it
# at http{} scope. Holds named upstreams, rate-limit zones, gzip settings,
# and the CORS origin map — anything that can't live inside a server block.

# Compression (gzip/brotli) used to live here. It now renders in server-scope
# inside server.tmpl / tls-server.tmpl because the stock Debian/Ubuntu
# /etc/nginx/nginx.conf already declares `gzip on;` at http-scope — emitting
# it again here triggers a `gzip directive is duplicate` error and breaks
# `nginx -t`. Server-scope overrides http-scope cleanly and behaviour is
# identical for the location-matched routes.

{{ range .Upstreams -}}
# --- Upstream: {{ .Name }} ({{ len .Servers }} server{{ if ne (len .Servers) 1 }}s{{ end }}) ---
upstream apigw_{{ .Name }} {
    {{ if .LoadBalance }}{{ .LoadBalance }};
    {{ end -}}
    {{ range .Servers -}}
    server {{ .Address }}{{ if gt .Weight 0 }} weight={{ .Weight }}{{ end }}{{ if gt .MaxFails 0 }} max_fails={{ .MaxFails }}{{ end }}{{ if .FailTimeout }} fail_timeout={{ .FailTimeout }}{{ end }}{{ if .Backup }} backup{{ end }}{{ if .Down }} down{{ end }};
    {{ end -}}
    keepalive {{ .Keepalive }};
    {{ if .KeepaliveTimeout }}keepalive_timeout {{ .KeepaliveTimeout }};
    {{ end -}}
    {{ if gt .KeepaliveRequests 0 }}keepalive_requests {{ .KeepaliveRequests }};
    {{ end -}}
}
{{ end }}

{{ range .RateLimitZones -}}
# --- Rate limit zone: {{ .Name }} ---
limit_req_zone {{ .Key }} zone=apigw_{{ .Name }}:10m rate={{ .RPS }}r/s;
{{ end }}

{{ if .CORSOriginMap -}}
# --- CORS origin allow-list (echo back if exact match, "" otherwise) ---
map $http_origin $apigw_cors_origin {
    default                       "";
    {{ range .CORSOriginMap -}}
    "~^{{ . }}$" $http_origin;
    {{ end -}}
}
{{ end }}

{{ range .SplitClients -}}
{{ if .Variants -}}
# --- N-way variant split for {{ .Name }} ({{ len .Variants }} variants) ---
split_clients "{{ .HashSource }}" ${{ .Name }} {
    {{ range .Variants -}}
    {{ if .Wildcard }}*{{ else }}{{ .Pct }}%{{ end }} {{ .UpstreamName }};
    {{ end -}}
}
{{ else -}}
# --- Canary split for {{ .Name }} ({{ .CanaryPct }}% to canary) ---
split_clients "{{ .HashSource }}" ${{ .Name }} {
    {{ .CanaryPct }}% {{ .CanaryName }};
    *                {{ .PrimaryName }};
}
{{ if .PinHeader -}}
# Pin override: clients sending the header pin to canary regardless of split.
map $http_{{ .PinHeader }} ${{ .TargetName }} {
    default ${{ .Name }};
    "1"     {{ .CanaryName }};
}
{{ end -}}
{{ end -}}
{{ end }}

{{ range .CacheZones -}}
# --- Response cache zone: {{ .Name }} ---
proxy_cache_path {{ .Path }} levels=1:2 keys_zone={{ .Name }}:10m max_size={{ .MaxSize }} inactive=60m use_temp_path=off;
{{ end }}

{{ if .JSONLogFormat -}}
# --- Structured JSON access log (SIEM-friendly) ---
log_format apigw_json escape=json '{'
    '"ts":"$time_iso8601",'
    '"remote":"$remote_addr",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"referer":"$http_referer",'
    '"ua":"$http_user_agent",'
    '"forwarded":"$http_x_forwarded_for",'
    '"rtime":$request_time,'
    '"upstream":"$upstream_addr",'
    '"upstream_status":"$upstream_status",'
    '"upstream_rtime":"$upstream_response_time",'
    '"cache":"$upstream_cache_status",'
    '"apigw_subject":"$sent_http_x_apigw_subject"'
'}';
{{ end }}

{{ if and (ne .LogSampleRate 100) (gt .LogSampleRate 0) -}}
# --- Log sampling: only log {{ .LogSampleRate }}% of requests ---
split_clients "$request_id" $apigw_log_sample {
    {{ .LogSampleRate }}% 1;
    *                     0;
}
map $apigw_log_sample $apigw_log_skip {
    1 0;
    default 1;
}
{{ end }}

{{ if .IPReputationFeed -}}
# --- IP reputation blocklist (BotGuard.UseIPReputation) ---
# File format: one IP or CIDR per line, # for comments. Update the file
# then `apigw api reload` to push the new list to nginx.
geo $apigw_ip_blocked {
    default 0;
    include {{ .IPReputationFeed }};
}
{{ end }}

{{ range .TLSPatternMaps -}}
# --- TLS pattern blocker for {{ .APIName }} ---
# Synthetic profile: <protocol>|<cipher>|<curves>|<ciphers>.
# Real JA3 requires the ngx_ssl_ja3 module; this is the stock-nginx
# approximation good enough to block legacy TLS + obvious tool patterns.
map "$ssl_protocol|$ssl_cipher|$ssl_curves|$ssl_ciphers" $apigw_tls_blocked_{{ .APIName }} {
    default 0;
    {{ range .Patterns -}}
    "~{{ . }}" 1;
    {{ end -}}
}
{{ end }}
