#!/sbin/openrc-run
# apigw deploy {{ .Name }} — OpenRC supervised service.
# Generated by apigw — do not edit manually.

name="apigw-deploy-{{ .Name }}"
description="apigw deployment {{ .Name }}"
command="/bin/sh"
command_args="{{ .WorkDir }}/.apigw/start.sh"
command_user="{{ .User }}:{{ .Group }}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/apigw/{{ .Name }}.log"
error_log="/var/log/apigw/{{ .Name }}.err"
supervisor="supervise-daemon"
supervise_daemon_args="--respawn-delay 5 --respawn-max 0"

depend() {
    need net
    after nginx
}

start_pre() {
    checkpath --directory --owner {{ .User }}:{{ .Group }} --mode 0755 /var/log/apigw
}
